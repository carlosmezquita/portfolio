{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-dashboard",
  "account_id": "1db26bf02a050c742294458d1adc328b",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
